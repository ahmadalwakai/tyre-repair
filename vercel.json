{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --workspace apps/web run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-abandoned-bookings",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-tyrerescue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-tyrerescue-stock",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-tr-catalogue",
      "schedule": "0 */6 * * *"
    }
  ]
}
